# Backend/site origin this extension talks to (NOT including /api -- that's
# appended in code, see lib/config.ts). Baked in at build time (wxt
# dev/build), never derived from the page the extension happens to be open
# on. Matches this repo's root .env.example's PUBLIC_BASE_URL.
#
# Local dev/testing (matches docker-compose's Caddy reverse proxy):
WXT_API_BASE_URL=http://localhost

# Production: the real deployed origin, e.g.
# WXT_API_BASE_URL=https://attendix.example.com
