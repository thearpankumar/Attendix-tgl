{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.18.0",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://attendixv2.talenciaglobal.com/api"
      }
    },
    "preview": {
      "node": "24.18.0",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://attendixv2.talenciaglobal.com/api"
      }
    },
    "production": {
      "node": "24.18.0",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://attendixv2.talenciaglobal.com/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
