{
  "expo": {
    "name": "Attendix Mentor",
    "slug": "attendix-mentor",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "attendix-mentor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Attendix uses Face ID to quickly and securely unlock your session."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arpankumar1119.attendixmentor"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4f46e5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Attendix uses Face ID to quickly and securely unlock your session."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Attendix uses Face ID to quickly and securely unlock your session."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://attendixv2.talenciaglobal.com/api",
      "router": {},
      "eas": {
        "projectId": "1ddd6999-90ea-4971-975d-70c4a98ca2cc"
      }
    }
  }
}
