# Docker Compose Environment Variables
# Copy to .env and configure before running docker-compose up

# ============================================
# CORE CONFIGURATION
# ============================================
NODE_ENV=production
DOMAIN=your-domain.com

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING
ADMIN_SECRET=CHANGE-THIS-TO-SECURE-ADMIN-CREATION-SECRET

# ============================================
# WEBAUTHN CONFIGURATION
# ============================================
WEBAUTHN_RP_NAME=Attendix Attendance System
WEBAUTHN_RP_ID=your-domain.com
WEBAUTHN_ORIGIN=https://your-domain.com

# ============================================
# STORAGE CONFIGURATION
# ============================================
# Choose: 'cloudinary' or 's3'
STORAGE_PROVIDER=s3

# Cloudinary (required when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AWS S3 (required when STORAGE_PROVIDER=s3)
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ECR images (docker-compose.prod.yml) — defaults already point at
# tgl/attendix in ap-south-1; only set these to override.
# ECR_REGISTRY=559444199242.dkr.ecr.ap-south-1.amazonaws.com
# ECR_REPOSITORY=tgl/attendix
# IMAGE_TAG=latest

# ============================================
# REDIS CACHE
# ============================================
REDIS_PASSWORD=change_this_to_a_secure_redis_password
REDIS_URL=redis://:change_this_to_a_secure_redis_password@redis:6379

# ============================================
# POSTGRES
# ============================================
POSTGRES_DB=attendance_geotag
POSTGRES_USER=attendix
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password
PG_MAX_POOL_SIZE=300
PG_MIN_POOL_SIZE=20

# ============================================
# POSTGRES BACKUP (pg-backup service, docker-compose.postgres.yml)
# Nightly pg_dump uploaded to s3://$AWS_S3_BUCKET/postgres-backups/ — reuses
# the AWS_* credentials above, no separate bucket needed.
# ============================================
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# DEV_BYPASS_ALL: Controls the Developer Bypass Mode at the environment level.
# If true: 
#   - Injects mock buttons in the student frontend for testing (Bypass Camera/Location/WebAuthn).
#   - Relaxes backend constraints so mock submissions are accepted and recorded with a "flagged" audit trail.
# If false: 
#   - The system runs in strict production mode. Mock buttons are hidden.
#   - All hardware and location checks are strictly enforced and cannot be bypassed.
# Note: You can now also toggle this dynamically via the Admin Dashboard > Settings.
DEV_BYPASS_ALL=false

# ============================================
# MONITORING: Grafana (docker-compose.monitoring.yml)
# Grafana is reached only through Caddy at /logging-grafana-main. Override
# GRAFANA_ROOT_URL for prod so it emits links against the real domain, not
# localhost. Prometheus has no route/host port at all — internal-only,
# reachable only by Grafana as http://prometheus:9090.
# ============================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
GRAFANA_ROOT_URL=https://your-domain.com/logging-grafana-main/
# CIDRs whose X-Forwarded-For is trusted (the Caddy container's subnet).
# Rate limiting is keyed on the extracted IP; an unvalidated header here lets
# any client bypass every limiter by varying it.
TRUSTED_PROXIES=172.18.0.0/16

# Bearer token for Prometheus scrapes of the backend /metrics endpoint.
# Generate with: openssl rand -base64 48
METRICS_TOKEN=

# Optional KMS key for server-side encryption of Postgres dumps in S3.
# Unset falls back to SSE-S3 (AES256), which is still applied.
BACKUP_KMS_KEY_ID=

# Origin the site is served from, used to build shareable short links
# ({PUBLIC_BASE_URL}/s/{code}). Distinct from WEBAUTHN_ORIGIN, which is the
# WebAuthn relying-party origin — set this to what a student's browser sees
# (e.g. https://attendix.example.com), not the backend's own port.
PUBLIC_BASE_URL=http://localhost
