# ============================================
# CORE CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING
JWT_EXPIRE=7d
ADMIN_SECRET=CHANGE-THIS-TO-SECURE-ADMIN-CREATION-SECRET

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated exact origins. `*` is rejected at boot: the API is called
# with a bearer token from the admin SPA and same-origin from the student page,
# so a wildcard is never correct. An unparseable entry is also fatal — this
# used to fall through to allow-any.
CORS_ORIGIN=https://attendix.example.com

# ============================================
# WEBAUTHN CONFIGURATION
# ============================================
WEBAUTHN_RP_NAME=Attendix Attendance System
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ============================================
# STORAGE CONFIGURATION (S3)
# ============================================
STORAGE_PROVIDER=s3
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ============================================
# REDIS CACHE (optional)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# POSTGRES CONNECTION
# ============================================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/attendance_geotag
PG_MAX_POOL_SIZE=50
PG_MIN_POOL_SIZE=5

# ============================================
# DEVELOPMENT BYPASS
# ============================================
DEV_BYPASS_ALL=false
DEV_BYPASS_MOBILE_CHECK=false

# ============================================
# LOGGING
# ============================================
RUST_LOG=info

# ============================================
# IP LOOKUP (optional)
# ============================================
IP_API_URL=http://ip-api.com/json/

# CIDRs whose X-Forwarded-For header is trusted for client-IP extraction.
# Set this to the Caddy container's subnet. Leave empty to always use the
# socket peer address. Rate limiting is keyed on the result, so trusting an
# unvalidated header here lets any client mint a fresh bucket per request.
TRUSTED_PROXIES=172.18.0.0/16

# Bearer token Prometheus presents when scraping /metrics. Must match the
# credentials_file referenced in monitoring/prometheus/prometheus.yml.
# Generate with: openssl rand -base64 48
METRICS_TOKEN=

# Origin the site is served from, used to build shareable short links
# ({PUBLIC_BASE_URL}/s/{code}). Distinct from WEBAUTHN_ORIGIN, which is the
# WebAuthn relying-party origin — set this to what a student's browser sees
# (e.g. https://attendix.example.com), not the backend's own port.
PUBLIC_BASE_URL=http://localhost
