// Grafana Alloy log pipeline for Attendix.
//
// Pipeline:
//   Docker socket discovery
//     → relabel (container name as label)
//     → loki.source.docker (tails container stdout/stderr)
//     → loki.process (JSON parse → extract level + module as labels)
//     → loki.write (Loki)
//
// The backend (backend-rust) emits structured JSON logs via
// tracing_subscriber::fmt::layer().json() (see backend-rust/src/main.rs)
// when NODE_ENV != development, e.g.:
//   {"timestamp":"...","level":"INFO","fields":{"message":"..."},"target":"attendance_geotag_backend::controllers::attendance"}
// `level` is already an uppercase string (INFO/WARN/ERROR/DEBUG/TRACE) — no
// translation needed. `target` (the emitting Rust module path) is promoted
// to a `module` label so you can filter efficiently:
//   {container="attendance-backend", level="ERROR"}
//   {container="attendance-backend"} | json | module=~"controllers::attendance"
//
// Caddy's own JSON access logs (`log { format json }` in the Caddyfile) use
// lowercase levels natively and pass through this same pipeline unaffected.
// Non-JSON lines (MongoDB/Redis plain text) pass through unchanged as raw strings.

// ─── 1. Discover all Docker containers ─────────────────────────────────────
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// ─── 2. Relabel: extract clean container name ───────────────────────────────
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

// ─── 3. Source: tail container logs ────────────────────────────────────────
loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = { "job" = "docker" }
  forward_to = [loki.process.json_pipeline.receiver]
}

// ─── 4. Process: parse JSON + extract labels ───────────────────────────────
loki.process "json_pipeline" {
  // Attempt to parse the log line as JSON (backend tracing / Caddy access
  // logs). If the line is not JSON (e.g. MongoDB/Redis plain text), this
  // stage is a no-op and the line passes through unchanged.
  //
  // `level` is a top-level string field for both the backend
  // (tracing_subscriber's JSON formatter) and Caddy — no translation stage
  // needed. `target` (the emitting Rust module path, e.g.
  // "attendance_geotag_backend::controllers::attendance") is only present
  // on backend logs and doubles as a "module" label.
  stage.json {
    expressions = {
      // Extract these fields from the JSON body for use in later stages.
      // They do NOT become labels here — just extracted values.
      extracted_level  = "level",
      extracted_module = "target",
      extracted_msg    = "fields.message",
    }
  }

  // Promote extracted fields to Loki stream labels.
  // Keep label cardinality LOW — only high-value, low-cardinality fields.
  // requestId, rollNumber, sessionId should stay in the log body (query with `| json`).
  stage.labels {
    values = {
      level  = "extracted_level",
      module = "extracted_module",
    }
  }

  forward_to = [loki.write.default.receiver]
}

// ─── 5. Write to Loki ──────────────────────────────────────────────────────
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
