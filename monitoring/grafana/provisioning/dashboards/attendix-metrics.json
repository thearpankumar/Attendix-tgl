        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(caddy_reverse_proxy_upstreams_healthy)",
          "legendFormat": "Backend",
          "refId": "A"
        }
      ],
      "title": "Backend Upstream Health",
      "type": "stat"
